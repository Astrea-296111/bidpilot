# Lite mode needs no key and no Docker. Copy this file to .env.
MODE=lite
RUNTIME_DIR=runtime
CHUNK_SIZE=500
CHUNK_OVERLAP=80
ENABLE_RERANKER=false
MAX_GRAPH_STEPS=30
MAX_RETRIEVAL_RETRY=1
MAX_TOOL_CALLS=10

# Full mode: MODE=full, configure your provider and a random shared secret.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
APPROVAL_SECRET=bidpilot-local-demo-only

# auto = hash in Lite, BAAI/bge-small-zh-v1.5 CPU model in Full.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# For an API embedding provider, set provider=api, real model name/key/dimensions.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=512

# Compose overrides hostnames; these values are for a host process.
# DATABASE_URL=postgresql+asyncpg://bidpilot:bidpilot@localhost:5432/bidpilot
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
MCP_TRANSPORT=stdio
MCP_URL=http://localhost:8001/mcp
